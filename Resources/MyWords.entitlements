<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The app links Homebrew's libsqlcipher, which is signed by a different
         Team ID. Under the hardened runtime, library validation would reject
         it; this entitlement permits loading validly-signed third-party
         libraries. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
